# Environment variables — copy to .env and fill in your values
# Do NOT commit .env to git

# Flask
FLASK_DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string

# Tableau (paste your published URLs here after publishing to Tableau Public/Server)
TABLEAU_DASHBOARD_URL=YOUR_TABLEAU_DASHBOARD_URL_HERE
TABLEAU_STORY_URL=YOUR_TABLEAU_STORY_URL_HERE

# Server
PORT=5000
